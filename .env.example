# Copy to .env and fill in. Never commit real secrets.

# CMS content database (managed by Prisma migrations)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/cms"

# Session signing secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# AES-256-GCM key for encrypting external data-source passwords at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATASOURCE_ENC_KEY=""

# Public base URL of THIS CMS. Used for the copy-paste embed snippet AND for
# absolute image-proxy URLs (see STORAGE_PROXY). Set this to your real host in
# production, e.g. https://cms.qosfc.com.
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seeded admin credentials (used once by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# News admin — public site base used ONLY to preview legacy image paths in the
# admin (stored values like "/images/..." or "~/..." that live on the public
# site). Newly-picked CDN images are absolute and unaffected. Optional; defaults
# to https://www.qosfc.com. The content DB itself is chosen in the News page UI
# (it reuses a Data Source), not via env.
# NEXT_PUBLIC_CONTENT_SITE_URL="https://www.qosfc.com"

# Image storage (optional) — enables uploads in the widget editor. Supports a
# WebDAV endpoint (a STORAGE_BASE_URL ending in /dav is auto-detected) or the
# Combined Storage API (github.com/andycqos74/combinedstorage). Leave blank to
# keep image fields URL-only.
STORAGE_BASE_URL="http://localhost:4000"
STORAGE_USERNAME="admin"
STORAGE_PASSWORD="changeme"
# Upload target: "root" (top level) or a sub-folder / sub-path.
STORAGE_UPLOAD_PARENT="root"
# Force the backend type (webdav|combined). Optional — inferred from the URL.
# STORAGE_TYPE="webdav"
#
# How images are served publicly (so embeds load them with no CDN login):
#   Proxy mode (DEFAULT for WebDAV): the CMS reads each file from storage with its
#   credentials and serves it from {APP_BASE_URL}/api/media/... — always works,
#   regardless of how your CDN exposes public files. Combined Storage already has
#   public /f/<token> URLs, so it stays direct. Override: STORAGE_PROXY=true|false.
# STORAGE_PROXY="true"
#   Direct mode (STORAGE_PROXY=false): image links point straight at the CDN. In
#   WebDAV mode this defaults to STORAGE_BASE_URL without the trailing "/dav"; set
#   STORAGE_PUBLIC_URL if your public host/path differs. Only works if your CDN
#   serves the files publicly with no login.
# STORAGE_PUBLIC_URL="https://cdn.example.com"
